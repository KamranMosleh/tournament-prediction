# Supabase - Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# football-data.org - free at football-data.org/client/register
FOOTBALL_DATA_API_KEY=your-football-data-key-here

# Groq AI - free at console.groq.com
GROQ_API_KEY=your-groq-key-here

# Required for scheduled/manual /api/sync calls (use the same value in Vercel and Supabase)
SYNC_SECRET=replace-with-any-random-string
