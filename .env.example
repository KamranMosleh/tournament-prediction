# Supabase — Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# football-data.org — free at football-data.org/client/register
FOOTBALL_DATA_API_KEY=your-football-data-key-here

# Groq AI — free at console.groq.com
GROQ_API_KEY=your-groq-key-here

# Vercel Cron secret (Vercel sets this automatically — add it to your Vercel env vars)
# https://vercel.com/docs/cron-jobs/manage-cron-jobs#securing-cron-jobs
CRON_SECRET=vercel-auto-generates-this

# For manual /api/sync calls (pick any random string)
SYNC_SECRET=replace-with-any-random-string
